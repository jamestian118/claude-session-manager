#!/usr/bin/env bash
set -euo pipefail

PATTERNS=(
  "BEGIN PRIVATE KEY"
  "AKIA[0-9A-Z]{16}"
  "xoxb-[A-Za-z0-9-]{20,}"
  "xoxp-[A-Za-z0-9-]{20,}"
  "ghp_[A-Za-z0-9]{36,}"
  "gho_[A-Za-z0-9_]{20,}"
  "github_pat_[A-Za-z0-9_]{20,}"
  "sk-[A-Za-z0-9_-]{20,}"
)

EXCLUDE_DIRS=(
  ".git"
  ".venv"
  "venv"
  "node_modules"
  "dist"
  "build"
  "coverage"
  "__pycache__"
  ".ai"
  ".ck"
  "docs"
  "tests"
)

EXCLUDE_FILES=(
  ".env.example"
)

exclude_args=()
for d in "${EXCLUDE_DIRS[@]}"; do
  exclude_args+=("--exclude-dir=$d")
done
for f in "${EXCLUDE_FILES[@]}"; do
  exclude_args+=("--exclude=$f")
done
exclude_args+=("--exclude=secrets-check")

hit=0
for p in "${PATTERNS[@]}"; do
  if grep -RInIE "${exclude_args[@]}" "$p" . >/dev/null 2>&1; then
    echo "[secrets-check] potential secret match: pattern='$p'"
    grep -RInIE "${exclude_args[@]}" "$p" . | head -n 50
    hit=1
  fi
done

if [[ "$hit" -ne 0 ]]; then
  echo "[secrets-check] FAIL"
  exit 1
fi

echo "[secrets-check] OK"
